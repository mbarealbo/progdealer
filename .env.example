# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Admin User Setup (for create-admin-user.js script)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
ADMIN_PASSWORD=your_secure_admin_password

# Security Notes:
# - Never commit the actual .env file to version control
# - Use strong, unique passwords
# - Rotate credentials regularly
# - Store production secrets in your deployment platform's secrets management
# Google Maps Platform (Places API New) — referrer-restricted browser key
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Firecrawl — used by scripts/scrape-events.mjs (event refresh cron).
# The scraper reads SUPABASE_URL (falls back to VITE_SUPABASE_URL) and the
# service-role key above. In CI these live as GitHub Actions secrets.
FIRECRAWL_API_KEY=your_firecrawl_api_key
# SUPABASE_URL=your_supabase_project_url   # optional; defaults to VITE_SUPABASE_URL
# SCRAPED_STATUS=pending                   # pending (moderation) | approved (auto-publish)
